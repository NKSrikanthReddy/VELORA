# ==============================================================================
# Velora Medical Record Consolidation & Clinical Briefing System
# Backend Environment Configuration Template
# ==============================================================================

# Database Configuration (SQLite for local development, PostgreSQL/Supabase for production)
DATABASE_URL=sqlite:///./velora.db
# DATABASE_URL=postgresql://postgres.xxxx:your_password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-velora-medical-hackathon-2026-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend URL (for CORS allowance)
FRONTEND_URL=http://localhost:3000

# AI / LLM Configuration (OpenAI / Gemini)
AI_API_KEY=
AI_MODEL=gpt-4o-mini
OCR_PROVIDER=pytesseract
OCR_MIN_TEXT_LENGTH=50
DEMO_MODE=true

# Supabase Storage (Optional - falls back to local storage if empty)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=medical-records

# File Upload Limits
MAX_FILE_SIZE_MB=20
LOCAL_STORAGE_DIR=./storage
